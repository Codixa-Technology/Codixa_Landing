{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc",
    "jsx-a11y",
    "nextjs"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "typescript/no-explicit-any": "error",
    "no-unused-vars": "error",
    "jsx-a11y/no-redundant-roles": "off",
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "ignorePatterns": [
    ".next",
    "node_modules",
    "scripts",
    ".qa"
  ]
}
